# CivicPulse Supabase & Database Configuration
# Copy this file to .env.local and populate with your Supabase project credentials.

# 1. Supabase Project URL (found in Supabase Dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# 2. Supabase Anon/Public Key (safe for browser client-side usage with RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 3. Supabase Service Role Key (PRIVILEGED - NEVER expose to browser/frontend!)
# Used strictly in server-side API routes, seed scripts, and admin tasks.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 4. Optional Direct PostgreSQL Connection String (for direct Prisma/pg/CLI migrations)
# DATABASE_URL=postgresql://postgres:your-db-password@db.your-project-id.supabase.co:5432/postgres

# Application Settings
NODE_ENV=development
